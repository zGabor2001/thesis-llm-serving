# Local development configuration. Copy to .env and adjust as needed.
# Shell-exported variables take precedence over values in .env.

# HuggingFace token — only needed to download gated models. Serving already
# downloaded weights does not require it.
HF_TOKEN=

# Backend selection:
#   mock - no Docker/vLLM needed; deterministic fake responses (offline dev)
#   vllm - talk to a real vLLM server at VLLM_BASE_URL
BACKEND_MODE=mock
VLLM_BASE_URL=http://localhost:8000
DEFAULT_MODEL=base-model

# Gateway listen address
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
REQUEST_TIMEOUT_S=60.0

# Optional: tokenizer.json path for DRR token counting (falls back to a heuristic)
# TOKENIZER_PATH=

# Scheduling policy: fifo | wrr | drr
SCHEDULER_MODE=fifo
# Optional: scheduler parameters (tenant:value pairs, comma-separated)
# TENANT_WEIGHTS=tenant-a:2,tenant-b:1,tenant-c:1
# TENANT_QUANTA=tenant-a:16,tenant-b:16,tenant-c:16
# LORA_TENANTS=tenant-a,tenant-b,tenant-c
